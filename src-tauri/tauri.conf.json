{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocaRay",
  "version": "0.1.1",
  "identifier": "app.locaray.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocaRay",
        "width": 760,
        "height": 680,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' asset:; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cloudflared"],
    "resources": [
      "resources/THIRD_PARTY_NOTICES.md",
      "resources/licenses/Apache-2.0.txt"
    ],
    "copyright": "Copyright 2026 LocaRay contributors",
    "shortDescription": "Temporary public URLs for local development servers"
  }
}
